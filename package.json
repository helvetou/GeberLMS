{
  "name": "geberstealth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LMS Helveticore — Learning Management System",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.domain.json --noEmit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:remote": "tsx scripts/migrate.ts --remote",
    "db:reset-password": "tsx scripts/reset-password.ts",
    "db:reset-password:remote": "tsx scripts/reset-password.ts --remote",
    "smoke": "tsx scripts/smoke-production.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.54.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-cloudflare": "^7.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "bits-ui": "^2.19.5",
    "cn": "^0.4.0",
    "embla-carousel-svelte": "^8.6.0",
    "layerchart": "^2.6.0",
    "paneforge": "^1.0.2",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "drizzle-orm": "^0.45.3",
    "marked": "^18.2.1",
    "mode-watcher": "^1.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  }
}
